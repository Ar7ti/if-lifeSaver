# Copy to server/.env. Run commands from server/ so this file is loaded.
HOST=127.0.0.1
PORT=3001
# Server-only. Never use a VITE_ or NEXT_PUBLIC_ prefix for these values.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# With no key, local planning and unavailable research are chosen automatically.
# AI_MODE=local
# RESEARCH_MODE=unavailable
# Explicit offline fictional offers: RESEARCH_MODE=demo
# Live: OPENAI_API_KEY plus AI_MODE=openai and RESEARCH_MODE=live
STORAGE_MODE=local
DATA_DIR=data
AI_TIMEOUT_MS=30000
RESEARCH_TIMEOUT_MS=45000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Required if HOST is not loopback. At least 24 characters; shared demo access token.
# API_TOKEN=
LOG_LEVEL=info
