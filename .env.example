# Copy to server/.env. Run commands from server/ so this file is loaded.
HOST=127.0.0.1
PORT=3001
# Server-only. Never use a VITE_ or NEXT_PUBLIC_ prefix for these values.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# With no key, local planning and unavailable research are chosen automatically.
# AI_MODE=local
# RESEARCH_MODE=unavailable
# Explicit offline fictional offers: RESEARCH_MODE=demo
# Live: OPENAI_API_KEY plus AI_MODE=openai and RESEARCH_MODE=live
STORAGE_MODE=local
DATA_DIR=data
AI_TIMEOUT_MS=60000
RESEARCH_TIMEOUT_MS=90000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Required if HOST is not loopback. At least 24 characters; shared demo access token.
# API_TOKEN=
LOG_LEVEL=info

# Public beta: opt-in only. Keep API_TOKEN configured for legacy startup/rollback.
PUBLIC_ACCESS_ENABLED=false
PUBLIC_AI_ENABLED=false
# Defaults to DATA_DIR/security.sqlite; Railway should set /data/security.sqlite.
# SECURITY_DB_PATH=data/security.sqlite
# Generate a NEW random administrator key, independent of API_TOKEN (32+ characters).
# ADMIN_ACCESS_KEY=
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=2592000
ADMIN_SESSION_TTL_SECONDS=3600
PUBLIC_AI_REQUESTS_PER_DAY=5
PUBLIC_MAX_CONCURRENT_AI_REQUESTS_PER_SESSION=1
GLOBAL_MAX_CONCURRENT_AI_REQUESTS=3
PUBLIC_MAX_WORKSPACES_PER_SESSION=5
GLOBAL_DAILY_AI_BUDGET_USD=3.00
ADMIN_DAILY_AI_BUDGET_USD=3.00
NEW_SESSIONS_PER_HOUR=10
GLOBAL_NEW_SESSIONS_PER_HOUR=100
# REQUIRED before enabling paid public AI: verify rates for OPENAI_MODEL.
# No price defaults are invented; missing rates fail closed.
# AI_INPUT_USD_PER_MILLION=
# AI_OUTPUT_USD_PER_MILLION=
# AI_WEB_SEARCH_USD_PER_CALL=
AI_RESERVED_INPUT_TOKENS=200000
# Insecure cookies are allowed ONLY with a loopback HOST for local HTTP testing.
# SESSION_COOKIE_SECURE=false

# Optional If Finland partner integration (all server-only). Defaults to unavailable.
# Obtain approved credentials with householder.quote.fi and householder.listcoverage.fi scopes.
# IF_CLIENT_ID=
# IF_CLIENT_SECRET=
# Only if supplied/required by your If partner subscription:
# IF_SUBSCRIPTION_KEY=
# sandbox uses If test data, never a live quote; switch only with production access.
IF_ENVIRONMENT=sandbox
IF_TIMEOUT_MS=8000

# Smart Protection Car API uses the same server-side If client, with car.price scope.
# Optional only if If supplies it for the documented partner header:
# IF_PARTNER_ID=
# Fictional car demo prices need no credentials and are selected explicitly in the UI.

# Structured product research — backend only; disabled by default.
# eBay production needs verified partner/API permission and display/retention terms.
EBAY_ENABLED=false
EBAY_ACCESS_APPROVED=false
EBAY_ENVIRONMENT=sandbox
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
EBAY_TIMEOUT_MS=8000
# Separate durable limits for actual OAuth/API requests; not OpenAI messages.
PRODUCT_REQUESTS_PER_DAY=20
GLOBAL_PRODUCT_REQUESTS_PER_DAY=100
# Enable only after confirming the account contract has no per-call API fees.
# Paid product-provider tariffs are not implemented in v1 and must remain disabled.
EBAY_FREE_API_CONFIRMED=false
